rules_version = '2';

// Each signed-in user can read and write only their own document: users/{their uid}.
// Every other read or write is refused, so no user can see or change another user's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
